# ============================================================
# 模型平台（provider）：配置任意一个或多个，按 GRADE_MODELS 顺序轮换
# 模型引用格式：provider/model，例如 dashscope/qwen3.8-flash
# ============================================================

# 阿里云百炼（OpenAI 兼容）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 只填能看图的模型；纯文本模型会被忽略
QWEN_MODELS=qwen3.8-flash,deepseek-v4.1-flash,qwen4-max

# DeepSeek 官方（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-flash

# Moonshot / Kimi 官方（OpenAI 兼容）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODELS=kimi-k3.1-pro

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=

# Google Gemini（OpenAI 兼容端点）
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODELS=

# OpenRouter（聚合平台，模型名可带斜杠，如 openrouter/anthropic/claude-sonnet-4）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=

# 任意 OpenAI 兼容平台（自定义）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODELS=

# 跨平台统一尝试顺序，优先级最高；留空则自动收集所有已配置平台的模型
# 例：GRADE_MODELS=dashscope/qwen3.8-flash,deepseek/deepseek-flash,moonshot/kimi-k3.1-pro
GRADE_MODELS=

# 兼容旧配置：只填一个百炼模型时使用；QWEN_MODELS 非空时优先用列表
QWEN_MODEL=