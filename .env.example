# 阿里云百炼（通义千问 VL）API Key
# 不要提交真实 Key；在 Vercel 项目 Settings -> Environment Variables 里配置
DASHSCOPE_API_KEY=

# 可选：默认使用北京地域的 OpenAI 兼容地址
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：按顺序尝试的视觉模型；当前模型额度用完/限流会自动换下一个
# 注意：只能填 Qwen-VL / Qwen3-VL / QVQ 等能看图的模型，纯文本模型不能批改
QWEN_MODELS=qwen3-vl-plus,qwen3-vl-flash,qwen3-vl-8b-instruct,qwen-vl-plus,qwen-vl-max

# 兼容旧配置：只填一个模型时使用；QWEN_MODELS 非空时优先用列表
QWEN_MODEL=qwen3-vl-plus